  m_Script: {fileID: 11500000, guid: 38f39af1130d840989f14c0c0a5b0604, type: 3}
  m_Name: Champion_Archer
  m_EditorClassIdentifier: Assembly-CSharp::ElementalBuddies.ChampionDefinitionSO
  Class: 2
  DisplayName: "Bogensch\xFCtze"
  Tagline: "Pr\xE4ziser Sch\xFCtze aus den W\xE4ldern"
  Description: "Ein Waldl\xE4ufer, der aus gro\xDFer Entfernung pr\xE4zise Pfeile
    verschie\xDFt. Mit seiner Rolle bleibt er stets in Bewegung, und t\xFCckische
    Fallen halten die Gegner auf Abstand."
  Portrait: {fileID: 21300000, guid: 21a989a888e3f462691b04f407000f2d, type: 3}
  PreviewPrefab: {fileID: 509132437810379993, guid: af26305be5e714f94b2fba8d64708859, type: 3}
  AccentColor: {r: 0.3, g: 0.62, b: 0.32, a: 1}
  Abilities:
  - Key: LMB
    Name: Pfeilschuss
    Description: "Schneller Pfeil mit gro\xDFer Reichweite."
    Icon: {fileID: 21300000, guid: 4d7977475c61343bba779425c9f1e2d1, type: 3}
    Element: -1
  - Key: RMB
    Name: Rolle
    Description: Hechtrolle (4,5 m), kurz unverwundbar. 2 Aufladungen.
    Icon: {fileID: 21300000, guid: ba624d643b09e48329c06eb29327bd26, type: 3}
    Element: -1
  - Key: R
    Name: Feuerpfeil-Regen
    Description: Brennende Pfeile regnen auf das Zielgebiet und setzen Gegner in
      Brand.
    Icon: {fileID: 21300000, guid: caa0e30d150ab4aee8eadf67af2d61e4, type: 3}
    Element: 0
  - Key: F
    Name: Frostpfeil
    Description: Durchschlagender Pfeil, der alle getroffenen Gegner einfriert.
    Icon: {fileID: 21300000, guid: 6506aa29ba65a4dfd8c620f8689206e8, type: 3}
    Element: 1
  - Key: C
    Name: Dornenfalle
    Description: "Legt eine Falle, die Gegner festh\xE4lt und verletzt."
    Icon: {fileID: 21300000, guid: 40d935889966749bdad37636e3362371, type: 3}
    Element: 2
  - Key: V
    Name: Lichtpfeil
    Description: Lichtstrahl, der alle Gegner in einer Linie durchbohrt und blendet.
    Icon: {fileID: 21300000, guid: 8fc34e22259bd4fe0aa9d687e3822a36, type: 3}
    Element: 3
